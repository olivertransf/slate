# Cloudflare R2, S3 API. Never commit real values.
R2_ENDPOINT=https://c4082e46de92362b88f334060c85e78d.r2.cloudflarestorage.com
R2_BUCKET=void
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# scrypt$<salt>$<hash> from `node scripts/hash-passphrase.mjs`
SYNC_PASSPHRASE_HASH=

# Random string used to sign session cookies.
SESSION_SECRET=

# Google Calendar OAuth web client. Secret stays on the server.
# Authorized JavaScript origin: http://localhost:3000
# Authorized redirect URI: http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
